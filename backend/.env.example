# ---------------------------------------------------------------------------
# Local development
# ---------------------------------------------------------------------------
MONGODB_URI=mongodb://localhost:27017/judaica-shop
JWT_SECRET=change-me
PORT=5000
NODE_ENV=development
# Comma-separated list is allowed, e.g. http://localhost:5173,https://your-app.onrender.com
FRONTEND_URL=http://localhost:5173

STORE_NAME=

# ---------------------------------------------------------------------------
# Production (set these in the hosting dashboard, never commit real values)
# ---------------------------------------------------------------------------
# MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/judaica-shop
# NODE_ENV=production
# FRONTEND_URL=https://<your-app>.onrender.com
# PORT is injected by the host — do not set it manually.

SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=

GREEN_INVOICE_API_KEY=
GREEN_INVOICE_API_SECRET=
GREEN_INVOICE_ENV=
GREEN_INVOICE_DOC_TYPE=
GREEN_INVOICE_VAT_TYPE=
