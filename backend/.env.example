# ---------------------------------------------------------------------------
# Local development
# ---------------------------------------------------------------------------
MONGODB_URI=mongodb://localhost:27017/judaica-shop
JWT_SECRET=change-me
PORT=5000
NODE_ENV=development
# Comma-separated list is allowed, e.g. http://localhost:5173,https://your-app.onrender.com
FRONTEND_URL=http://localhost:5173

STORE_NAME=

# ---------------------------------------------------------------------------
# Production (set these in the hosting dashboard, never commit real values)
# ---------------------------------------------------------------------------
# MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/judaica-shop
# NODE_ENV=production
# FRONTEND_URL=https://<your-app>.onrender.com
# PORT is injected by the host — do not set it manually.

SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=

GREEN_INVOICE_API_KEY=
GREEN_INVOICE_API_SECRET=
GREEN_INVOICE_ENV=
GREEN_INVOICE_DOC_TYPE=
GREEN_INVOICE_VAT_TYPE=

# ---------------------------------------------------------------------------
# Nedarim Plus — credit card payments (iframe + server-created transaction)
# Get MOSAD_ID + API_VALID from Nedarim Plus support / the institution dashboard.
# Until both are set, production shows "payment unavailable" and development
# falls back to the mock checkout.
# ---------------------------------------------------------------------------
NEDARIM_MOSAD_ID=
NEDARIM_API_VALID=
# Optional: API key (npk_...) from reports.matara.pro > הגדרות > API. Enables a
# live cross-check when a CallBack arrives from an IP that isn't on the list.
NEDARIM_API_PASSWORD=
# Optional: HMAC secret for the signed CallBack URL (defaults to JWT_SECRET).
NEDARIM_WEBHOOK_SECRET=
# Optional: max installments (תשלומים) offered at checkout, 1-36. Default 1.
NEDARIM_MAX_INSTALLMENTS=1
# Optional: category (Groupe) stamped on every store transaction in Nedarim reports.
NEDARIM_GROUPE=
# Optional: override the documented CallBack sender IPs (comma-separated).
NEDARIM_CALLBACK_IPS=
# Optional: public base URL Nedarim calls back to, e.g. https://your-app.onrender.com
# (defaults to the host the checkout request came in on).
PUBLIC_URL=
